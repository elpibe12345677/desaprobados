---
import Navbar from "./Navbar.astro";
import "../styles/global.css";

const visitCount = 0;
---

<header class="site-header">
  <table>
    <tbody>
      <tr>
        <td class="site-logo">
          <a href="/"><img src="desaprobados.png" alt="DESAPROBADOS por la SOCIEDAD" width="455px" height="245px"></a>
        </td>

        <td class="socials">
          <a href="#"><img src="imgs/ig.svg" alt="Instagram" width="50px" height="50px"></a>
          <a href="#"><img src="imgs/x.svg" alt="X" width="50px" height="50px"></a>
        </td>

        <td class="search">
          <input type="search" placeholder="buscar..." aria-label="Buscar" />
        </td>

        <td class="visits">
          visitas: {visitCount}
        </td>
      </tr>

      <tr>
        <td colspan="4">
          <Navbar />
        </td>
      </tr>
    </tbody>
  </table>
</header>
